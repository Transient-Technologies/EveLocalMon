<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EveLocalMon.App</RootNamespace>
    <AssemblyName>EveLocalMon</AssemblyName>
    <ApplicationManifest>App.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\icons\EveLocalMon.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EveLocalMon.Core\EveLocalMon.Core.csproj" />
    <ProjectReference Include="..\EveLocalMon.Platform.Windows\EveLocalMon.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window (taskbar button) icon; the .ico above is the exe's. Both come from tools/make-icon.ps1. -->
    <AvaloniaResource Include="..\..\assets\icons\EveLocalMon.png" Link="Assets\EveLocalMon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Saira files in assets/ are named one step off their real weight: "Medium.ttf" holds weight 400,
         "SemiBold.ttf" 500 and "Bold.ttf" 600 (checked against each file's OS/2 and name tables). They are
         embedded under their true names so weight lookup works; the family inside is "Saira SemiCondensed".
         Only the three weights the UI uses are embedded (doc/specs/M4-SPEC.md §2.2). -->
    <AvaloniaResource Include="..\..\assets\fonts\Saira_Semi_Condensed\SairaSemiCondensed-Medium.ttf" Link="Assets\Fonts\SairaSemiCondensed-Regular.ttf" />
    <AvaloniaResource Include="..\..\assets\fonts\Saira_Semi_Condensed\SairaSemiCondensed-SemiBold.ttf" Link="Assets\Fonts\SairaSemiCondensed-Medium.ttf" />
    <AvaloniaResource Include="..\..\assets\fonts\Saira_Semi_Condensed\SairaSemiCondensed-Bold.ttf" Link="Assets\Fonts\SairaSemiCondensed-SemiBold.ttf" />
    <AvaloniaResource Include="..\..\assets\fonts\Share_Tech_Mono\ShareTechMono-Regular.ttf" Link="Assets\Fonts\ShareTechMono-Regular.ttf" />
    <None Include="..\..\assets\fonts\**\OFL.txt" Link="licenses\%(RecursiveDir)OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped defaults, copied into %APPDATA%\EveLocalMon\templates on first run. -->
    <None Include="..\..\assets\templates\**\*" Link="assets\templates\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
